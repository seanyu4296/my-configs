  "metals.javaHome": "/opt/homebrew/opt/openjdk@11/libexec/openjdk.jdk/Contents/Home",
  "editor.tokenColorCustomizations": {
    // "[Night Owl]": {
    "textMateRules": [
      {
        "scope": ["support.function.delimeter.purescript"],
        "settings": {
          "foreground": "#ecc70e" // dd6fd5
        }
      },
      {
        "scope": ["punctuation.definition.parenthesis.purescript"],
        "settings": {
          "foreground": "#6fb6de"
        }
      }
    ]
    // }
  },
  "vscode_custom_css.imports": ["file:///Users/seanyu/Random/synthglow.css"],
  "workbench.colorCustomizations": {
